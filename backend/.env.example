# LLM Configuration
LLM_PROVIDER=openai  # options: openai, anthropic, google-genai
LLM_MODEL=gpt-4o-mini  # or claude-3-haiku-20240307, gemini-1.5-flash

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini
GOOGLE_API_KEY=your_google_api_key_here

# Optional services
OSRM_URL=  # Leave empty to use haversine distance only

# CORS origins (comma separated)
CORS_ORIGINS=http://localhost:3000

# Server configuration
PORT=8000
DEBUG=true

# Feature flags
EXPOSE_ANSWERS=true  # Set to false to hide answers/hints in mission response